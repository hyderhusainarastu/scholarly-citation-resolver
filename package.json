{
  "name": "scholarly-citation-resolver",
  "version": "0.1.0",
  "description": "Resolve messy free-text citations to verified metadata from Crossref, OpenAlex, Open Library, Google Books, Semantic Scholar and arXiv, and refuse wrong matches.",
  "license": "MIT",
  "type": "module",
  "main": "dist/src/index.js",
  "types": "dist/src/index.d.ts",
  "bin": { "cite-resolve": "dist/src/cli.js" },
  "files": ["dist/src", "README.md", "LICENSE"],
  "engines": { "node": ">=20" },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "test": "vitest run",
    "eval": "npm run build && node dist/eval/eval.js",
    "eval:live": "npm run build && node dist/eval/eval.js --live --record"
  },
  "keywords": ["citations", "bibliography", "crossref", "openalex", "doi", "citation-parser", "metadata"],
  "devDependencies": {
    "@types/node": "22.10.2",
    "typescript": "5.9.3",
    "vitest": "3.2.4"
  }
}
